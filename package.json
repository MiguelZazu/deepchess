{
  "name": "deepchess",
  "private": true,
  "version": "0.1.0",
  "description": "Analizador de partidas de ajedrez con Stockfish 19 Lite",
  "author": "DeepChess",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "copy-engine": "node scripts/copy-engine.mjs",
    "predev": "npm run copy-engine",
    "dev": "vite --host",
    "prebuild": "npm run copy-engine",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host",
    "openings": "node scripts/build-openings.mjs",
    "puzzles": "node scripts/build-puzzles.mjs",
    "icons": "node scripts/icons.mjs",
    "pieces": "node scripts/fetch-pieces.mjs",
    "desktop": "npm run build && electron .",
    "desktop:win": "npm run build && electron-builder --win nsis portable",
    "desktop:mac": "npm run build && electron-builder --mac dmg",
    "desktop:linux": "npm run build && electron-builder --linux AppImage",
    "android:sync": "npm run build && cap sync android && node scripts/prune-android.mjs",
    "android:apk": "npm run android:sync && cd android && gradlew.bat assembleDebug",
    "android:release": "npm run android:sync && cd android && gradlew.bat assembleRelease",
    "android:open": "cap open android"
  },
  "build": {
    "appId": "com.deepchess.app",
    "productName": "DeepChess",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "!dist/engine/stockfish-19-single.*",
      "electron/**/*",
      "build/icon.png",
      "package.json",
      "!node_modules/**/*"
    ],
    "icon": "build/icon.png",
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "DeepChess",
      "artifactName": "DeepChess-${version}-setup.${ext}"
    },
    "portable": {
      "artifactName": "DeepChess-${version}-portable.${ext}"
    },
    "mac": {
      "category": "public.app-category.games"
    },
    "linux": {
      "category": "Game"
    }
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/comfortaa": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/lato": "^5.3.0",
    "@fontsource/merriweather": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "chess.js": "^1.4.0",
    "idb-keyval": "^6.3.0",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-chessboard": "^5.12.1",
    "react-dom": "^19.3.1",
    "stockfish": "19.0.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "sharp": "^0.35.5",
    "typescript": "~5.9.0",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^2.0.0"
  }
}
